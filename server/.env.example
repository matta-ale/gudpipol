# Copiá este archivo como .env para desarrollo local

# Base de datos local (MySQL instalado en Windows)
DB_HOST=localhost
DB_USER=admin
DB_PASSWORD=admin
DB_DATABASE=gudpipol_db_dev
DB_PORT=3306

# Si usás Docker en su lugar (docker compose up -d):
# DB_HOST=localhost
# DB_PORT=3307

PORT=3001

# Mercado Pago / URLs — usar credenciales de test en local
PUBLIC_KEY=
ACCESS_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
APP_URL_FRONTEND=http://localhost:3000
APP_URL=http://localhost:3001
